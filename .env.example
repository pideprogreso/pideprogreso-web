# Copia este archivo a .env.local y llena los valores del proyecto
# "pideprogreso-app" en Supabase (Project Settings > API).
# Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública del sitio (opcional). Ej.: https://pideprogreso.com
# NEXT_PUBLIC_SITE_URL=
